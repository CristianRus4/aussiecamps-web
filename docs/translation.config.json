{
  "schemaVersion": 1,
  "project": "aussiecamps",
  "catalogs": [
    {
      "id": "aussiecamps-website",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": [
        "de",
        "es",
        "it",
        "nl",
        "pt",
        "ja",
        "ko",
        "zh-hans",
        "zh-hant",
        "da",
        "sv",
        "nb",
        "cs",
        "pl"
      ],
      "source": "../lib/translations/en.json",
      "targets": [
        {
          "locale": "de",
          "path": "../lib/translations/de.json"
        },
        {
          "locale": "es",
          "path": "../lib/translations/es.json"
        },
        {
          "locale": "it",
          "path": "../lib/translations/it.json"
        },
        {
          "locale": "nl",
          "path": "../lib/translations/nl.json"
        },
        {
          "locale": "pt",
          "path": "../lib/translations/pt.json"
        },
        {
          "locale": "ja",
          "path": "../lib/translations/ja.json"
        },
        {
          "locale": "ko",
          "path": "../lib/translations/ko.json"
        },
        {
          "locale": "zh-hans",
          "path": "../lib/translations/zh-hans.json"
        },
        {
          "locale": "zh-hant",
          "path": "../lib/translations/zh-hant.json"
        },
        {
          "locale": "da",
          "path": "../lib/translations/da.json"
        },
        {
          "locale": "sv",
          "path": "../lib/translations/sv.json"
        },
        {
          "locale": "nb",
          "path": "../lib/translations/nb.json"
        },
        {
          "locale": "cs",
          "path": "../lib/translations/cs.json"
        },
        {
          "locale": "pl",
          "path": "../lib/translations/pl.json"
        }
      ],
      "protectedTerms": ["AussieCamps", "AussieCamping", "AUD", "Tourism Australia", "Reserve Bank of Australia", "Virgin Australia", "New South Wales", "Victoria", "Queensland", "South Australia", "Western Australia", "Tasmania", "Northern Territory", "Australian Capital Territory", "Central Australia"],
      "glossary": { "Australia": { "de": "Australien", "es": "Australia", "fr": "Australie", "it": "Australia", "nl": "Australië", "pt": "Austrália" } },
      "varieties": { "pt": "pt-PT" },
      "register": { "de": "informal", "es": "informal", "fr": "formal", "it": "informal", "nl": "informal", "pt": "informal" }
    },
    {
      "id": "aussiecamps-website-zh-Hant",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": ["zh-Hant"],
      "source": "../lib/translations/en.json",
      "targets": [
        { "locale": "zh-Hant", "path": "../lib/translations/zh-hant.json" }
      ],
      "protectedTerms": ["AussieCamps", "AussieCamping", "AUD"],
      "untranslatedKeys": ["ui.review*", "ui.reviewsEyebrow", "ui.reviewsTitle"],
      "glossary": {
        "New South Wales": { "zh-Hant": "新南威爾斯" },
        "Queensland": { "zh-Hant": "昆士蘭" },
        "Victoria": { "zh-Hant": "維多利亞" },
        "South Australia": { "zh-Hant": "南澳" },
        "Western Australia": { "zh-Hant": "西澳" },
        "Tasmania": { "zh-Hant": "塔斯馬尼亞" },
        "Northern Territory": { "zh-Hant": "北領地" },
        "Australian Capital Territory": { "zh-Hant": "澳洲首都領地" }
      }
    }
  ]
}
