// The AussieCamps place pages that don't fit on GitHub Pages (Cristian, 14 Nov 2026): the ~20,000 places
// without a full listing, rendered by the site's own place template (`PLACES_R2=1 npm run places:worker` →
// worker-dist), uploaded to the R2 bucket aussiecamps-places (scripts/sync-places-r2.mjs, only changed pages)
// and served by this Worker on the free plan: R2 has no file limit. Everything else stays on GitHub Pages:
// the Worker passes any other request through unchanged (src/index.js).
// Since 15 Nov 2026 it also serves the live trip and collection links (the app's "Send link"): the API at
// /api/links/* stores them in the bucket aussiecamps-links, and /trip/<id> and /collection/<id> show them.
{
  "name": "aussiecamps-places",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "PLACES", "bucket_name": "aussiecamps-places" },
    // The links people publish from the app. Never synced or emptied by the build (pages.yml creates it).
    { "binding": "LINKS", "bucket_name": "aussiecamps-links" }
  ],
  // Per IP (CF-Connecting-IP), free: writes to the links API, and reads of the API and the link pages. The namespace
  // ids are this site's own (KiwiCamping uses 2001 and 2002 in the same Cloudflare account).
  "ratelimits": [
    { "name": "LINK_WRITES", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LINK_READS", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  // Runs on these paths of aussiecamps.app (the domain's DNS records are proxied through Cloudflare).
  "routes": [
    { "pattern": "aussiecamps.app/places/*", "zone_name": "aussiecamps.app" },
    { "pattern": "aussiecamps.app/api/links/*", "zone_name": "aussiecamps.app" },
    { "pattern": "aussiecamps.app/trip/*", "zone_name": "aussiecamps.app" },
    { "pattern": "aussiecamps.app/collection/*", "zone_name": "aussiecamps.app" }
  ]
}
