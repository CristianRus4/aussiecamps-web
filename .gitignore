# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/pages-dist/
/.wrangler/
/outputs/
/work/
tsconfig.tsbuildinfo

# Place pages: the plain data stays on this Mac and in CI (scripts/export-places.mjs)
/lib/data/places.json
/lib/data/place-stubs.json
/lib/data/places.photos.json

# The Cloudflare Worker's place pages (npm run places:worker), never part of the Pages export
/worker-dist
/places-worker/.wrangler
/r2-dist
